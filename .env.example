# ============================================================================
# MCP Server Environment Variables
# ============================================================================
# This file contains environment variable templates for MCP servers.
# Copy this file to .env and fill in your actual values.
#
# IMPORTANT: Never commit the .env file with actual secrets!
# ============================================================================

# ----------------------------------------------------------------------------
# Context7 MCP Server
# ----------------------------------------------------------------------------
# Purpose: Provides up-to-date code documentation for LLMs
# Required: Optional (basic features work without API key)
# How to get: Visit https://context7.com and generate an API key
# Permissions: Read access to documentation
CONTEXT7_API_KEY=your_context7_api_key_here

# ----------------------------------------------------------------------------
# GitHub MCP Server
# ----------------------------------------------------------------------------
# Purpose: Repository management, issues, PRs, code search
# Required: Yes
# How to get: GitHub Settings → Developer settings → Personal access tokens → Generate new token
# Permissions: repo, read:org, read:user, workflow (adjust based on needs)
# Docs: https://docs.github.com/en/authentication/keeping-your-account-and-data-secure/managing-your-personal-access-tokens
GITHUB_TOKEN=ghp_your_github_personal_access_token

# ----------------------------------------------------------------------------
# Playwright MCP Server
# ----------------------------------------------------------------------------
# Purpose: Browser automation and web testing
# Required: Optional (defaults provided)
# Values: DEBUG (true/false), HEADLESS (true/false)
PLAYWRIGHT_DEBUG=false
PLAYWRIGHT_HEADLESS=true

# ----------------------------------------------------------------------------
# Linear MCP Server
# ----------------------------------------------------------------------------
# Purpose: Project management and issue tracking
# Required: Yes
# How to get: Linear Settings → API → Personal API Keys → Create new key
# Permissions: Read and write access (or customize based on needs)
# Format: lin_api_xxxxxxxxxxxxxxxxxxxxxxxx
# Docs: https://linear.app/docs/graphql/working-with-the-graphql-api
LINEAR_API_KEY=lin_api_your_linear_api_key_here

# ----------------------------------------------------------------------------
# Figma MCP Server
# ----------------------------------------------------------------------------
# Purpose: Design file access and design-to-code workflows
# Required: Yes
# How to get: Figma → Settings → Account → Personal Access Tokens → Generate new token
# Permissions: File read access (adjust based on needs)
# Format: figd_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Docs: https://help.figma.com/hc/en-us/articles/8085703771159-Manage-personal-access-tokens
FIGMA_API_KEY=your_figma_personal_access_token

# ----------------------------------------------------------------------------
# Azure MCP Server
# ----------------------------------------------------------------------------
# Purpose: Azure service integration and management
# Required: Yes (all three values required for service principal authentication)
# How to get: Azure Portal → App registrations → New registration → Create service principal
# 1. AZURE_TENANT_ID: Azure AD tenant ID (found in Azure Portal → Azure Active Directory → Overview)
# 2. AZURE_CLIENT_ID: Application (client) ID from app registration
# 3. AZURE_CLIENT_SECRET: Client secret from app registration → Certificates & secrets
# Permissions: Assign appropriate Azure RBAC roles to the service principal
# Docs: https://learn.microsoft.com/en-us/azure/developer/azure-mcp-server/get-started
AZURE_TENANT_ID=your_azure_tenant_id
AZURE_CLIENT_ID=your_azure_client_id
AZURE_CLIENT_SECRET=your_azure_client_secret

# ============================================================================
# Additional Configuration (Optional)
# ============================================================================

# If you're behind a proxy, some MCP servers (like Context7) support these:
# HTTPS_PROXY=http://proxy.example.com:8080
# HTTP_PROXY=http://proxy.example.com:8080

# ============================================================================
# Security Notes
# ============================================================================
# 1. Keep your .env file secure and never commit it to version control
# 2. Rotate API keys and tokens regularly
# 3. Use the principle of least privilege - only grant necessary permissions
# 4. For team environments, consider using a shared secret manager:
#    - Azure Key Vault
#    - AWS Secrets Manager
#    - HashiCorp Vault
#    - 1Password
# 5. Monitor API key usage for unusual activity
# ============================================================================
