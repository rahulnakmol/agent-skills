skill:
  name: the-principal-planner
  version: 1.0.0
  last_updated: 2025-11-09
  next_review: 2026-02-09

classification:
  type: implementation-planning
  domain: software-engineering
  methodology: safe-invest-agile
  target_audience: ai-coding-agents

expertise:
  role: principal-software-engineer
  experience_years: 20+
  target_consumers:
    - claude-code
    - openai-codex
    - cursor
    - github-copilot-workspace
  specializations:
    - distributed-systems
    - open-source-development
    - cloud-native-architecture
    - agent-executable-planning

workflow:
  phases:
    - discovery-and-context-gathering
    - solution-architecture
    - detailed-planning
    - plan-generation

  methodologies:
    - SAFe (Scaled Agile Framework)
    - INVEST (Independent, Negotiable, Valuable, Estimable, Small, Testable)
    - Story Mapping
    - Iteration Planning

tech_stack_coverage:
  dotnet:
    - CSharp (latest stable)
    - Azure Cloud
    - Azure Functions, App Services, Container Apps
    - Azure DevOps, GitHub Actions

  python:
    - Python 3.11+
    - Web APIs (FastAPI, Django, Flask, Starlette)
    - Machine Learning (TensorFlow, PyTorch, scikit-learn, Hugging Face)
    - Data Analysis (pandas, NumPy, Polars, DuckDB)
    - Statistical Modelling (statsmodels, scipy, PyMC)
    - Agentic Automation (LangChain, LlamaIndex, CrewAI, AutoGen)
    - Data Engineering (Airflow, Prefect, Dagster)
    - Cloud-agnostic deployment
    - Containerized and serverless deployments

  golang:
    - Go 1.21+
    - GCP (Cloud Run, Cloud Functions, GKE)
    - Firebase
    - gRPC, REST APIs

  typescript_node:
    - Node.js, Bun
    - Express, Fastify, NestJS
    - Serverless, containerized deployments

  typescript_react:
    - React with shadcn/ui
    - React with Fluent UI v9+
    - Component architecture
    - State management

  typescript_svelte:
    - Svelte, SvelteKit
    - TailwindCSS
    - SSR, static generation

  alpine_tailwind:
    - Alpine.js with TailwindCSS
    - Third-party embedding
    - Progressive enhancement
    - Minimal bundle sizes

model_requirements:
  supported:
    - claude-opus-4.1
    - claude-opus-4
    - claude-sonnet-4.5
    - claude-sonnet-4
  reasoning: Deep technical reasoning and contextual understanding required

integration:
  linear_mcp: true  # Fetch PRDs from Linear.app
  supports_attachments: true  # Process PRDs, specs, diagrams, wireframes

deliverables:
  prd_structure: safe-aligned-feature-prd
  plan_format: agent-executable-implementation-plan-md
  story_format: invest-compliant-user-stories
  task_breakdown: iterations-stories-tasks-subtasks
  execution_format: precise-file-level-instructions

key_principles:
  - Agent-executable instructions (no human interpretation needed)
  - INVEST-compliant user stories
  - SAFe methodology alignment for organization
  - 1 PRD = 1 Feature paradigm
  - Iteration-based delivery structure
  - Precise file paths and code signatures
  - NFRs with verification commands
  - Test-driven approach with exact test commands
  - Definition of Done with automated verification
  - Technical debt tracking
  - Risk-first planning
  - Unambiguous execution steps

quality_standards:
  - Agent-executable without human clarification
  - Precise file paths and exact commands
  - Clear acceptance criteria with verification commands
  - Testable success metrics (automated)
  - Dependency mapping with installation commands
  - Risk mitigation strategies (technical)
  - Architecture decision records
  - Continuous integration focus
  - Incremental value delivery per task
  - Unambiguous instructions at every step

output_artifacts:
  - PRD.md (SAFe-aligned Feature documentation)
  - [featurename]-plan.md (agent-executable implementation plan)
  - Architecture Decision Records (ADRs)
  - API specifications (OpenAPI/Swagger with examples)
  - Data models and ER diagrams with migration scripts
  - Test strategy with exact test commands
  - File structure specifications
  - Verification command sequences
  - Build and deployment instructions

platforms:
  compatible:
    - Claude Chat (web)
    - Claude Code

  optimized_for:
    - Complex feature planning
    - Multi-iteration projects
    - Cross-functional teams
    - Agile delivery environments

changelog:
  - version: 1.0.0
    date: 2025-11-09
    changes:
      - Initial release targeting AI coding agents
      - 4-phase workflow implementation
      - SAFe/INVEST methodology for organization
      - 7 tech stack coverage areas
      - Expanded Python coverage (APIs, ML, data analysis, statistical modelling, agentic automation)
      - Agent-executable instruction format
      - PRD creation with INVEST validation
      - Solution architecture with 3+ options analysis
      - Detailed iteration planning with file-level task breakdown
      - Precise file paths and code signatures
      - NFR implementation with verification commands
      - Definition of Done with automated verification
      - Risk register and technical mitigation strategies
      - DevOps and deployment planning with exact commands
      - Success metrics with programmatic validation
      - Unambiguous execution steps for autonomous agent execution

maintenance:
  review_cycle: quarterly
  update_triggers:
    - SAFe framework updates
    - Technology stack version changes
    - New architectural patterns
    - Community best practices evolution
    - Cloud platform updates

metrics:
  quality_targets:
    plan_completeness: 100%
    invest_compliance: 100%
    safe_alignment: 100%
    technical_accuracy: 100%
    actionability_score: 95%
